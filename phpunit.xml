<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true">
    <php>
        <!-- The stubs in tests/stubs stand in for WordPress here, so it must not load. -->
        <env name="QUERYABLE_NO_WP" value="1"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Concerns</directory>
            <directory>tests/Schema</directory>
            <file>tests/TableTest.php</file>
            <file>tests/ModelMakeTest.php</file>
            <file>tests/ModelCollationTest.php</file>
            <file>tests/ModelSchemaTest.php</file>
            <file>tests/ModelCompileSchemaTest.php</file>
            <file>tests/ModelMigrateTest.php</file>
            <file>tests/WpFunctionStubTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
